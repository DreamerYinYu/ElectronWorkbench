{
  "name": "electron-for-all",
  "version": "1.0.0",
  "description": "ElectronForAll 起步项目：双击启动显示 HelloWorld",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "dreameryin",
  "build": {
    "appId": "com.dreameryin.electronforall",
    "productName": "ElectronForAll",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.15.3"
  }
}
